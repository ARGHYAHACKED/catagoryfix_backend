NODE_ENV=development
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001
API_PREFIX=/api/v1
API_PORT=3001
WORKER_CONCURRENCY=5

DATABASE_URL=postgresql://catalogfix:catalogfix@localhost:5432/catalogfix?schema=public
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=replace-with-32-char-access-secret-min
JWT_REFRESH_SECRET=replace-with-32-char-refresh-secret-min
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
PASSWORD_PEPPER=replace-with-random-pepper-value
ENCRYPTION_KEY=replace-with-64-hex-chars-32-bytes-key!!

COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

R2_ACCOUNT_ID=local
R2_ACCESS_KEY_ID=minio
R2_SECRET_ACCESS_KEY=miniosecret
R2_BUCKET=catalogfix
R2_ENDPOINT=http://localhost:9000
R2_PUBLIC_URL=http://localhost:9000/catalogfix
R2_FORCE_PATH_STYLE=true
R2_REGION=auto

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=
STRIPE_PRO_PRICE_ID=

RESEND_API_KEY=
EMAIL_FROM=CatalogFix <noreply@localhost>

SENTRY_DSN=
