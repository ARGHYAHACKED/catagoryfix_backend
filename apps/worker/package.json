{
  "name": "@catalogfix/worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file ../../.env src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file ../../.env dist/main.js",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@catalogfix/catalog-core": "workspace:*",
    "@catalogfix/config": "workspace:*",
    "@catalogfix/database": "workspace:*",
    "@catalogfix/logger": "workspace:*",
    "@catalogfix/queue": "workspace:*",
    "@catalogfix/shopify": "workspace:*",
    "@catalogfix/storage": "workspace:*",
    "@catalogfix/validation": "workspace:*",
    "bullmq": "^5.34.5",
    "unzipper": "^0.12.3"
  },
  "devDependencies": {
    "@types/unzipper": "^0.10.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
